# .env.example — Copy this to .env for local development overrides.
# For production (Render.com), set these in the Render dashboard instead.
# Lines starting with # are comments. Remove the # to enable a setting.

# ─────────────────────────────────────────────────────────────────────────────
# DJANGO CORE
# ─────────────────────────────────────────────────────────────────────────────

# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-this-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
# Example: ALLOWED_HOSTS=expressiondetector-api.onrender.com,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated CORS origins (your frontend URL)
# Example: CORS_ALLOWED_ORIGINS=https://expressiondetector.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — Neon PostgreSQL (production)
# Leave unset locally to use SQLite (default)
# ─────────────────────────────────────────────────────────────────────────────

# Get from: https://neon.tech → your project → Connection string
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require


# ─────────────────────────────────────────────────────────────────────────────
# REDIS — Upstash (production Celery broker)
# Leave unset locally to use filesystem broker (default)
# ─────────────────────────────────────────────────────────────────────────────

# Get from: https://console.upstash.com → your Redis DB → REST URL
# REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379


# ─────────────────────────────────────────────────────────────────────────────
# VIDEO STORAGE
# ─────────────────────────────────────────────────────────────────────────────
# No external storage needed! Videos are saved locally and sent directly
# to HuggingFace Space via file upload. Works on Render's free disk.


# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE CLOUD RUN — ML Worker
# ─────────────────────────────────────────────────────────────────────────────
# URL of your deployed ML Worker (FastAPI on Cloud Run).
# If left blank, the system will try to run ML locally in the Celery worker (requires torch/retinaface).

# ML_WORKER_URL=https://ml-worker-xxx-uc.a.run.app
